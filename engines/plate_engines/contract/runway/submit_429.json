{
  "note": "synthetic: create over the rolling 24 h generation cap: 429 {error}",
  "request": {
    "method": "POST",
    "url": "https://api.dev.runwayml.com/v1/image_to_video",
    "body": {
      "model": "kling3.0_pro",
      "promptImage": [
        {
          "uri": "data:image/png;base64,",
          "position": "first"
        }
      ],
      "promptText": "Rate probe: the doors open.",
      "ratio": "1920:1080",
      "duration": 5,
      "audio": false,
      "cfgScale": 0.5
    }
  },
  "response": {
    "status": 429,
    "json": {
      "error": "You have exceeded your daily generation limit."
    }
  }
}
