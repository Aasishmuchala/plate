{
  "note": "synthetic: Kling 3.0 Pro start frame (1920:1080, cfgScale 0.5); answers the Kling O3 task id so kling_o3_poll serves it",
  "request": {
    "method": "POST",
    "url": "https://api.dev.runwayml.com/v1/image_to_video",
    "body": {
      "model": "kling3.0_pro",
      "promptImage": [
        {
          "uri": "data:image/png;base64,",
