      "promptText": "Dolly toward the balcony door.",
      "ratio": "1920:1080",
      "duration": 5,
      "audio": false,
      "cfgScale": 0.5
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "0a6a3a0e-5a1e-4d7a-9f49-2b6f0a4c2d11",
