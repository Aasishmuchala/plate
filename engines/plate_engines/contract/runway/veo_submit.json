{
  "note": "synthetic: Veo 3.1 start+end (1920:1080, duration 6 snapped from 5, audio off, negativePrompt, seed 1234)",
  "request": {
    "method": "POST",
    "url": "https://api.dev.runwayml.com/v1/image_to_video",
    "body": {
      "model": "veo3.1",
      "promptImage": [
        {
          "uri": "data:image/png;base64,",
          "position": "first"
        },
        {
          "uri": "data:image/png;base64,",
          "position": "last"
        }
      ],
      "promptText": "Camera holds; steam rises from the cup.",
      "ratio": "1920:1080",
      "duration": 6,
      "audio": false,
      "seed": 1234,
      "negativePrompt": "blur, text"
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "5b0e8c1f-2d34-4a6b-8c9d-0e1f2a3b4c5d",
      "estimatedCost": {
        "credits": 120
      }
    }
  }
}
