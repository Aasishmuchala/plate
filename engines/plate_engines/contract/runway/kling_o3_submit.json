{
  "note": "synthetic: Kling O3 4K start+end on image_to_video (16:9 frames -> 3840:2160, 5 s, audio off, negative folded as Avoid:)",
  "request": {
    "method": "POST",
    "url": "https://api.dev.runwayml.com/v1/image_to_video",
    "body": {
      "model": "klingO3_4k",
      "promptImage": [
        {
          "uri": "data:image/png;base64,",
          "position": "first"
        },
        {
          "uri": "data:image/png;base64,",
          "position": "last"
        }
      ],
      "promptText": "Push in to the dining table; the light shifts to dusk.\nAvoid: morphing, warping, extra people",
      "ratio": "3840:2160",
      "duration": 5,
      "audio": false
    }
  },
  "response": {
    "status": 200,
    "json": {
      "id": "0a6a3a0e-5a1e-4d7a-9f49-2b6f0a4c2d11",
      "estimatedCost": {
        "credits": 215
      }
    }
  }
}
