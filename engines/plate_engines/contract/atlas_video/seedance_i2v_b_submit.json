{
  "note": "synthetic: Seedance 2.5 i2v on Atlas: image is the first frame, integer duration, upper-case resolution",
  "request": {
    "method": "POST",
    "url": "https://api.atlascloud.ai/api/v1/model/generateVideo",
    "body": {
      "model": "bytedance/seedance-2.5/image-to-video",
      "image": "https://static.atlascloud.ai/media/plate/start_b.png",
      "prompt": "Camera holds still; late sun moves across the oak floor.",
      "duration": 5,
      "resolution": "480P",
      "ratio": "adaptive",
      "camera_fixed": true,
      "generate_audio": false,
      "return_last_frame": false,
      "seed": 7
    }
  },
  "response": {
    "status": 200,
    "json": {
      "code": 200,
      "message": "success",
      "data": {
        "id": "pred_vid_b1",
        "status": "created"
      }
    }
  }
}
