{
  "note": "synthetic: accepted at submit; the real-face check fires later",
  "request": {
    "method": "POST",
    "url": "https://api.atlascloud.ai/api/v1/model/generateVideo",
    "body": {
      "model": "bytedance/seedance-2.5/image-to-video",
      "image": "https://static.atlascloud.ai/media/plate/person_late.png",
      "prompt": "Camera holds still; late sun moves across the oak floor.",
      "duration": 5,
      "resolution": "480P",
      "ratio": "adaptive",
      "camera_fixed": true,
      "generate_audio": false,
      "return_last_frame": false,
      "seed": 7
    }
  },
  "response": {
    "status": 200,
    "json": {
      "code": 200,
      "message": "success",
      "data": {
        "id": "pred_vid_face",
        "status": "created"
      }
    }
  }
}
